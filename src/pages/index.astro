---
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = [
  {date:'2023-09-14', title:'Frida安装', desc:'Frida host / Android server setup and basic verification.', href:'/research/frida-install/'},
  {date:'2023-09-14', title:'Frida绕过证书校验', desc:'Android mobile security notes on certificate pinning bypass.', href:'/research/frida-certificate-pinning/'},
  {date:'2023-09-14', title:'Charles抓手机客户端包', desc:'Mobile traffic interception notes.', href:'/research/charles-mobile/'},
  {date:'2023-03-08', title:'Natas 1–10', desc:'Web security fundamentals through OverTheWire Natas.', href:'/oscp/natas-1-10/'},
  {date:'2023-02-28', title:'Bandit 1–10', desc:'Linux command-line fundamentals through OverTheWire Bandit.', href:'/oscp/bandit-1-10/'},
];
---
<BaseLayout>
  <section class="hero">
    <div class="eyebrow">SECURITY RESEARCH · PENTEST · OSCP</div>
    <h1>Learn. Break.<br />Document.</h1>
    <p>A technical notebook for penetration testing, security research, CTFs and the OSCP journey.</p>
  </section>
  <section class="section">
    <div class="section-title">LATEST NOTES</div>
    <div class="post-list">
      {posts.map((post) => <a class="post-card" href={post.href}><time>{post.date}</time><div><h2>{post.title}</h2><p>{post.desc}</p></div><span class="tag">READ →</span></a>)}
    </div>
  </section>
  <section class="section">
    <div class="section-title">KNOWLEDGE BASE</div>
    <div class="post-list">
      <a class="post-card" href="/oscp/"><time>01</time><div><h2>OSCP</h2><p>Machine writeups, enumeration, exploitation and privilege escalation.</p></div><span class="tag">EXPLORE →</span></a>
      <a class="post-card" href="/pentest/"><time>02</time><div><h2>Pentesting</h2><p>Web, Windows, Linux, Active Directory and practical tooling.</p></div><span class="tag">EXPLORE →</span></a>
      <a class="post-card" href="/research/"><time>03</time><div><h2>Research</h2><p>Mobile security, Frida, Burp Suite and security experiments.</p></div><span class="tag">EXPLORE →</span></a>
    </div>
  </section>
</BaseLayout>
