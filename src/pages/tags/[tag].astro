---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){const posts=await getCollection('posts');const tags=[...new Set(posts.flatMap(p=>p.data.tags))];return tags.map(tag=>({params:{tag},props:{tag,posts:posts.filter(p=>p.data.tags.includes(tag)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf())}}));}
const {tag,posts}=Astro.props;
---
<BaseLayout title={`#${tag} — Liu Huikang`} description={`Security notes tagged ${tag}.`}><section class="section"><div class="eyebrow">TAG</div><h1>#{tag}</h1><div class="post-list">{posts.map(p=><a class="post-card" href={`/posts/${p.id}/`}><time>{p.data.pubDate.toISOString().slice(0,10)}</time><div><h2>{p.data.title}</h2><p>{p.data.description}</p></div></a>)}</div></section></BaseLayout>
