---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.type === 'research')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Research — Liu Huikang">
  <section class="hero">
    <div class="eyebrow">KNOWLEDGE BASE · RESEARCH</div>
    <h1>Research</h1>
    <p>Mobile security, Frida, traffic interception and practical security tooling.</p>
  </section>

  <section class="section">
    <div class="section-title">ARTICLES</div>
    <div class="post-list">
      {posts.map((post) => (
        <a class="post-card" href={`/posts/${post.id}/`}>
          <time>{post.data.pubDate.toISOString().slice(0, 10)}</time>
          <div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </div>
          <span class="tag">READ →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
