---
const { title = 'Liu Huikang — Security Research', description = 'Security research, penetration testing, OSCP notes and technical writeups.' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://1iuhuikang.github.io').href;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#f7f7f5" /><link rel="canonical" href={canonicalUrl} /><link rel="alternate" type="application/rss+xml" title="Liu Huikang RSS" href="/rss.xml" /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:site_name" content="Liu Huikang — Security Research" /><meta name="twitter:card" content="summary" /><link rel="icon" href="/favicon.svg" /><title>{title}</title></head><body>
<header class="site-header"><a class="brand" href="/">LIU HUIKANG</a><nav><a href="/oscp/">OSCP</a><a href="/pentest/">PENTEST</a><a href="/research/">RESEARCH</a><a href="/notes/">NOTES</a><a href="/archives/">ARCHIVE</a><a href="/tags/">TAGS</a><a href="/search/">SEARCH</a></nav><button id="theme-toggle" aria-label="Toggle dark mode">◐</button></header><main><slot /></main><footer class="site-footer"><span>LIU HUIKANG</span><span>Security Research · Pentest · OSCP · <a href="/rss.xml">RSS</a></span></footer><script is:inline>const key='theme',root=document.documentElement,saved=localStorage.getItem(key);if(saved)root.dataset.theme=saved;document.querySelector('#theme-toggle')?.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;localStorage.setItem(key,next)});</script></body></html>
<style is:global>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600;700&display=swap');:root{font-family:Inter,'Noto Sans SC',system-ui,sans-serif;color:#161616;background:#f7f7f5;line-height:1.75}:root[data-theme='dark']{color:#e6e6e6;background:#0d1117}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}.site-header{min-height:72px;max-width:1180px;margin:auto;padding:0 28px;display:flex;align-items:center;gap:28px;border-bottom:1px solid #deded9}.brand{font-size:14px;font-weight:700;letter-spacing:.14em;white-space:nowrap}.site-header nav{display:flex;gap:18px;flex:1;flex-wrap:wrap}.site-header nav a{font-size:11px;letter-spacing:.07em;color:#6d6d68}.site-header button{border:0;background:none;cursor:pointer;font-size:18px;color:inherit}.site-footer{max-width:1180px;margin:100px auto 0;padding:28px;border-top:1px solid #deded9;display:flex;justify-content:space-between;font-size:12px;color:#777}main{max-width:1180px;margin:auto;padding:0 28px}.hero{padding:110px 0 80px;max-width:860px}.eyebrow{font:500 12px 'JetBrains Mono',monospace;letter-spacing:.12em;color:#777;text-transform:uppercase}.hero h1{font-size:clamp(42px,7vw,76px);line-height:1.03;margin:18px 0}.hero p{max-width:660px;color:#6d6d68;font-size:18px}.section{padding:40px 0}.section-title{font:500 12px 'JetBrains Mono',monospace;letter-spacing:.1em;color:#777;margin-bottom:20px}.post-list{border-top:1px solid #deded9}.post-card{display:grid;grid-template-columns:120px 1fr auto;gap:30px;padding:24px 0;border-bottom:1px solid #deded9}.post-card time{font:12px 'JetBrains Mono',monospace;color:#888}.post-card h2{margin:0;font-size:22px}.post-card p{margin:5px 0 0;color:#777}.tag{font:11px 'JetBrains Mono',monospace;color:#777;margin-right:10px}.article{max-width:820px;margin:auto;padding:90px 0}.article-header{padding-bottom:55px;border-bottom:1px solid #deded9}.article h1{font-size:clamp(40px,6vw,64px);line-height:1.08;margin:14px 0}.article-meta{font:12px 'JetBrains Mono',monospace;color:#777;display:flex;gap:18px;flex-wrap:wrap}.prose{padding-top:50px}.prose h2{font-size:28px;margin:52px 0 16px}.prose h3{font-size:20px;margin:36px 0 12px}.prose p,.prose li{font-size:16px}.prose code{font-family:'JetBrains Mono',monospace;background:#ecece7;padding:2px 5px;border-radius:4px}.prose pre{overflow:auto;background:#111318;color:#e8e8e8;padding:20px;border-radius:10px;font:13px/1.65 'JetBrains Mono',monospace}.prose blockquote{margin:24px 0;padding:4px 20px;border-left:2px solid #888;color:#666}.prose img{max-width:100%;height:auto;border-radius:10px}.prose a{text-decoration:underline;text-underline-offset:3px}.toc{margin:28px 0;padding:18px 20px;border:1px solid #deded9;border-radius:8px;font-size:13px}.toc ol{margin:8px 0;padding-left:20px}.archive-year{font:500 18px 'JetBrains Mono',monospace;margin:40px 0 12px}.search-box{width:100%;font:16px 'JetBrains Mono',monospace;padding:14px 16px;border:1px solid #bbb;border-radius:8px;background:transparent;color:inherit}.result{padding:18px 0;border-bottom:1px solid #deded9}.result h3{margin:0 0 4px}.muted{color:#777}:root[data-theme='dark'] .site-header,:root[data-theme='dark'] .site-footer,:root[data-theme='dark'] .article-header,:root[data-theme='dark'] .post-list,:root[data-theme='dark'] .toc,:root[data-theme='dark'] .result{border-color:#30363d}:root[data-theme='dark'] .site-header nav a,:root[data-theme='dark'] .hero p,:root[data-theme='dark'] .post-card p,:root[data-theme='dark'] .prose blockquote,:root[data-theme='dark'] .muted{color:#8b949e}:root[data-theme='dark'] .prose code{background:#21262d}@media(max-width:720px){.site-header{padding:12px 20px}.site-header nav{display:none}.post-card{grid-template-columns:1fr;gap:5px}.site-footer{display:block}.site-footer span{display:block;margin:5px 0}.hero{padding-top:70px}}</style>